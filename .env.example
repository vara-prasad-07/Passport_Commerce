# Copy this file to .env in the same directory and fill in your own values.
# .env is gitignored — never commit real keys.

# Required for buyer-agent (intent parsing, negotiation, explanations).
# Get one at https://console.groq.com
GROQ_API_KEY=

# Optional overrides — defaults shown
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_EXPLAIN_MODEL=openai/gpt-oss-20b
#
# Reasoning effort, for reasoning models only (gpt-oss, qwen3). "low" roughly
# halves latency here. Set it to empty if you point GROQ_MODEL at a model that
# does not accept the parameter.
# GROQ_REASONING_EFFORT=low

# Razorpay TEST-mode credentials (from the Razorpay Dashboard, Test mode).
# Leave both blank to run in simulated payment mode: same code path and UI
# flow, but no real Razorpay API calls are made.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Only needed if you run a service on a non-default port
# PASSPORT_BASE_URL=http://localhost:8001
# MARGINMIND_BASE_URL=http://localhost:8002
